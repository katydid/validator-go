<<
import (
  . "go.katydid.org.za/validator-go/validator/ast"
  "go.katydid.org.za/validator-go/validator/types"
  "go.katydid.org.za/validator-go/validator/token"
  "strconv"
)

func newString(v interface{}) string {
  t := v.(*token.Token)
  return string(t.Lit)
}

func unquote(s1 string) string {
  s, err := strconv.Unquote(s1)
  if err != nil {
    return s1
  }
  return s
}

>>
